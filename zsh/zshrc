export ZSH="$HOME/.oh-my-zsh"
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
)
source $ZSH/oh-my-zsh.sh

[ -s "$HOME/.config/envman/load.sh" ] && source "$HOME/.config/envman/load.sh"

typeset -U path PATH
path=(
  $HOME/.opencode/bin
  $HOME/.local/bin
  $HOME/.npm-global/bin
  $HOME/.local/opt/go/bin
  $HOME/go/bin
  $path
)

export EDITOR=nvim
export SUDO_EDITOR=/usr/bin/nvim
export MOZ_ENABLE_WAYLAND=1

alias vim='NVIM_APPNAME=neovim nvim'
alias vv='NVIM_APPNAME=nvim-custom nvim'
alias ls=lsd
alias ff='nvim $(fzf --preview="bat --color=always {}")'
alias gvim="nvim --listen /tmp/godothost"

source <(fzf --zsh)
eval "$(starship init zsh)"

# hstate: pull Hermes state before an interactive session.
# Only for `hermes` alone or `hermes -p <profile>`; subcommands (dashboard, profile...) run directly.
# If the pull fails (unpushed local changes, network), warn and start anyway.
hermes() {
  if [[ $# -eq 0 || ( $# -eq 2 && ( $1 == -p || $1 == --profile ) ) ]]; then
    ~/.hermes/shared-skills/note-taking/hstate/scripts/hstate.sh pull \
      || print -P "%F{yellow}hstate pull non fait : session lancée sur l'état local%f"
  fi
  command hermes "$@"
}
