source <(fzf --zsh)
eval "$(starship init zsh)"

# hstate: pull Hermes state before an interactive session.
# Only for `hermes` alone or `hermes -p <profile>`; subcommands (dashboard, profile...) run directly.
# The pull is interactive (push / merge / keep GitHub / launch / quit). Exit 4 = user chose quit.
# Any other failure: ask before launching on the local state.
hermes() {
  if [[ $# -eq 0 || ( $# -eq 2 && ( $1 == -p || $1 == --profile ) ) ]]; then
    ~/.hermes/shared-skills/note-taking/hstate/scripts/hstate.sh pull
    local rc=$?
    (( rc == 4 )) && return 0
    if (( rc != 0 )); then
      print -P "%F{red}hstate pull en échec (code $rc).%f"
      local a; read -k1 "a?Lancer Hermes sur l'état local ? [o/N] "; echo
      [[ $a == [oOyY] ]] || return $rc
    fi
  fi
  command hermes "$@"
}

# Hermes Agent command
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac


