// Laptop (darkone, D-019): same bar as the desktop, workspaces on the left
// Values here override the included config (waybar(5): "the first defined value takes precedence").
{
    "include": ["~/.config/waybar/config"],
    "modules-left":   ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["mpris"],
    // Laptop: workspace numbers instead of icons (full module copied from modules.json, without format-icons)
    "hyprland/workspaces": {
        "on-click": "activate",
        "active-only": false,
        "all-outputs": true,
        "format": "{id}",
        "persistent-workspaces": { "*": [1, 2, 3, 4, 5, 6] }
    }
}
